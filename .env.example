# Server Configuration
PORT=3001
NODE_ENV=development

# Database - PostgreSQL (Supabase)
DATABASE_URL="postgresql://postgres:password@localhost:5432/hsms"

# MongoDB (if using MongoDB features)
MONGO_URI="mongodb://localhost:27017/HSMS"

# JWT Secret
JWT_SECRET_KEY="your-secret-key-here"

# API URLs
BACKEND_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:3000"

# Payment Gateway Configuration
DEFAULT_PAYMENT_GATEWAY="stripe"

# Payment Amount Limits (in INR)
MIN_PAYMENT_AMOUNT=1
MAX_PAYMENT_AMOUNT=100000

# Supported Payment Methods
SUPPORTED_PAYMENT_METHODS="card,upi,netbanking"

# Email Configuration
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"

# Stripe Payment Gateway (Test Keys)
STRIPE_PUBLISHABLE_KEY="pk_test_YOUR_TEST_KEY"
STRIPE_SECRET_KEY="sk_test_YOUR_TEST_KEY"
STRIPE_WEBHOOK_SECRET="whsec_YOUR_TEST_WEBHOOK_SECRET"
